# Connection details for scripts/deploy/bot.sh. Copy to scripts/deploy/deploy.env
# (gitignored) and fill in your VM. Not secret per se, but deployment-specific.

# Public IP / hostname of the container host (the Oracle Cloud VM).
OCI_VM_HOST=

# Path to the SSH private key that can log into the VM.
OCI_SSH_KEY=$HOME/.ssh/oci_whatsapp_bot

# SSH user (Oracle Ubuntu images default to "ubuntu").
OCI_VM_USER=ubuntu

# docker container name and the cloned repo dir on the VM.
CONTAINER_NAME=whatsapp-bot
REMOTE_DIR=openclaw-whatsapp-profiles

# Host path bind-mounted to /data in the container (holds baileys-auth + policy).
# DATA_DIR=/home/ubuntu/wa-data
