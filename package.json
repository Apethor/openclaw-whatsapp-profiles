{
  "name": "openclaw-whatsapp-profiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw WhatsApp policy and guidance profiles for contacts and groups.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "codex-proxy": "tsx src/codex-proxy/server.ts",
    "codex-proxy:dev": "tsx watch src/codex-proxy/server.ts",
    "codex-proxy:test": "tsx src/codex-proxy/smoke-test.ts",
    "claude-proxy": "tsx src/claude-proxy/server.ts",
    "claude-proxy:dev": "tsx watch src/claude-proxy/server.ts",
    "claude-proxy:test": "tsx src/claude-proxy/smoke-test.ts",
    "gemini:list": "tsx scripts/gemini-image-test.ts --list",
    "gemini:image": "tsx scripts/gemini-image-test.ts",
    "cf:list": "tsx scripts/cloudflare-image-test.ts --list",
    "cf:image": "tsx scripts/cloudflare-image-test.ts",
    "warmup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/warmup.ps1",
    "warmup:linux": "tsx scripts/warmup-linux.ts",
    "warmup:status": "tsx scripts/warmup-status.ts",
    "warmup:stop": "tsx scripts/warmup-stop.ts",
    "warmup:reset": "tsx scripts/warmup-reset.ts",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-service.ps1 Install",
    "service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-service.ps1 Uninstall",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-service.ps1 Status",
    "service:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-service.ps1 Run",
    "media:install": "python -m pip install -r requirements-media.txt",
    "tts:install": "python -m pip install -r requirements-tts.txt",
    "warmup:whisper": "tsx scripts/whisper-local.ts warmup",
    "whisper:install": "tsx scripts/whisper-local.ts install",
    "whisper:server": "tsx scripts/whisper-local.ts server",
    "whisper:status": "tsx scripts/whisper-local.ts status",
    "whisper:stop": "tsx scripts/whisper-local.ts stop",
    "openclaw:install-whatsapp": "openclaw plugins install clawhub:@openclaw/whatsapp --pin --force",
    "openclaw:patch-whatsapp-stickers": "tsx scripts/patch-whatsapp-sticker.ts",
    "openclaw:install-dispatch-plugin": "openclaw plugins install ./openclaw-plugins/whatsapp-policy-dispatch --force",
    "openclaw:repair-config": "tsx scripts/repair-openclaw-config.ts",
    "openclaw:schema-check": "tsx scripts/openclaw-schema-check.ts",
    "openclaw:worker": "tsx src/index.ts",
    "openclaw:send": "tsx scripts/openclaw-send.ts",
    "openclaw:control": "tsx scripts/openclaw-control.ts",
    "twilio:send": "tsx scripts/twilio-send.ts",
    "twilio:worker": "tsx scripts/twilio-worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "pino": "9.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "openclaw": "2026.5.20",
    "tsx": "^4.22.3",
    "typescript": "5.7.3"
  }
}
