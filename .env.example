BOT_MODE=observe
BOT_POLICY_PATH=./config/bot-policy.local.json
BOT_LOG_LEVEL=info
BOT_LOG_REPLY_CONTENT=false
# Prefer per-profile/per-target retroactiveReply in bot-policy. This legacy
# switch makes all configured auto targets eligible for OpenClaw history catch-up.
BOT_PROCESS_EXISTING_MESSAGES=false

# OpenClaw worker settings. The retroactive reply scanner uses these values.
OPENCLAW_POLL_INTERVAL_MS=10000
OPENCLAW_READ_LIMIT=10
OPENCLAW_GATEWAY_PORT=18789
# OpenClaw >=2026.6.10 refuses to bind the gateway in auto mode without auth.
# Set a token (any strong random value, e.g. `openssl rand -hex 24`). Required
# for the Docker/cloud deploy; the clawhub @openclaw/whatsapp plugin also needs
# runtime >=2026.6.10 (package.json pins it).
# OPENCLAW_GATEWAY_TOKEN=change-me-to-a-random-token
# OPENCLAW_ARGS=gateway run --force --allow-unconfigured
# OPENCLAW_COMMAND=node_modules\.bin\openclaw.cmd
# OPENCLAW_AGENTS_ASSISTANT_MODEL=openai-codex/gpt-5.4
# Set open to let OpenClaw receive every direct WhatsApp chat, while this
# project's bot-policy.local.json still decides who can get replies.
OPENCLAW_WHATSAPP_DM_POLICY=open
# OPENCLAW_NPX_PACKAGE=openclaw@2026.5.20
# OpenClaw 2026.5.x requires the WhatsApp channel as an external plugin:
# npm run openclaw:install-whatsapp

# Local HTTP bridge used by the OpenClaw dispatch plugin.
WHATSAPP_ASSISTANT_HOOK_HOST=127.0.0.1
WHATSAPP_ASSISTANT_HOOK_PORT=8790
WHATSAPP_ASSISTANT_HOOK_URL=http://127.0.0.1:8790/openclaw/message
WHATSAPP_ASSISTANT_DISPATCH_TIMEOUT_MS=120000

# Responder provider.
# Default: call an OpenAI-compatible API directly (no subscription required).
#
# RECOMMENDED for self-hosting (Docker/Oracle/Proxmox): the all-Cloudflare
# backend — chat, vision, image generation and transcription run on Cloudflare
# Workers AI over HTTP, web search via Tavily, and TTS via local edge-tts. No
# local model/CLI/proxy. Set RESPONDER_PROVIDER=cloudflare (see the Cloudflare
# block below) plus the per-feature provider switches:
#   RESPONDER_PROVIDER=cloudflare       -> chat + planner on Workers AI
#   IMAGE_GENERATOR_PROVIDER=cloudflare -> flux-1-schnell
#   TRANSCRIBER_PROVIDER=cloudflare     -> whisper-large-v3-turbo
#   SPEECH_PROVIDER=local               -> edge-tts (pt-BR-FranciscaNeural)
#   TAVILY_API_KEY=...                  -> web_search planner action
# Image understanding auto-selects Cloudflare when RESPONDER_PROVIDER=cloudflare.
# See docs/operations/docker.md and docs/operations/image-generation.md.
#
# Other local backends (mutually exclusive; CLAUDE_PROXY_ENABLED wins if both):
#   CLAUDE_PROXY_ENABLED=true -> back replies + image understanding with the
#                                `claude` CLI via the local proxy.
#   CODEX_PROXY_ENABLED=true  -> back replies with `codex exec` via codex-proxy.
CLAUDE_PROXY_ENABLED=false
CODEX_PROXY_ENABLED=false
RESPONDER_BASE_URL=https://api.openai.com/v1
RESPONDER_API_KEY=your-api-key
RESPONDER_MODEL=gpt-4o-mini
RESPONDER_TIMEOUT_MS=60000
#
# Cloudflare chat backend (overrides RESPONDER_BASE_URL/KEY/MODEL; derives the
# URL/key from CLOUDFLARE_ACCOUNT_ID/TOKEN below). Prefer an instruct model:
# reasoning models (e.g. @cf/openai/gpt-oss-120b) return their answer in
# reasoning_content, leaving content empty -> the worker falls back to a canned
# reply. llama-4-scout returns normal content and follows the planner prompt.
# RESPONDER_PROVIDER=cloudflare
# RESPONDER_CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
#
# Web search for Cloudflare/local chat models (they cannot browse): the worker
# runs Tavily when the planner emits a web_search action and injects snippets.
# Auto-on when TAVILY_API_KEY is set. WEB_SEARCH_PROVIDER=off disables it.
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_DEPTH=basic
#
# Other OpenAI-compatible providers work by changing RESPONDER_BASE_URL,
# RESPONDER_API_KEY, and RESPONDER_MODEL.

# Structured weather lookup. Profiles must set tools.weather=true before this
# is used. Open-Meteo does not require an API key.
WEATHER_ENABLED=true
WEATHER_FORECAST_BASE_URL=https://api.open-meteo.com
WEATHER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com
WEATHER_GEOCODING_LANGUAGE=pt
# WEATHER_GEOCODING_COUNTRY_CODE=BR
WEATHER_TIMEOUT_MS=8000

# Optional media generation. Profiles must opt in with tools.imageGeneration=true
# before image requests are generated and sent as WhatsApp media, or with
# tools.stickerGeneration=true before sticker requests are generated and sent.
# If CODEX_PROXY_ENABLED=true and CODEX_PROXY_MEDIA_PROVIDER is enabled, leaving
# IMAGE_GENERATOR_BASE_URL unset sends image generation through codex-proxy.
MEDIA_OUTPUT_DIR=./data/generated-media
MEDIA_REFERENCE_MAX_IMAGES=5
MEDIA_REFERENCE_MAX_AGE_MINUTES=120
MEDIA_REFERENCE_MAX_IMAGE_BYTES=20971520
# IMAGE_GENERATOR_BASE_URL=https://api.openai.com/v1
# IMAGE_GENERATOR_API_KEY=your-openai-api-key
IMAGE_GENERATOR_MODEL=gpt-image-1-mini
IMAGE_GENERATOR_SIZE=1024x1024
IMAGE_GENERATOR_QUALITY=low
IMAGE_GENERATOR_OUTPUT_FORMAT=png
IMAGE_GENERATOR_TIMEOUT_MS=120000
#
# Image generation provider. The `claude` CLI cannot generate images, so on the
# claude backend use Cloudflare Workers AI (free tier ~10k Neurons/day).
#   IMAGE_GENERATOR_PROVIDER=openai      -> OpenAI-compatible /images/generations
#   IMAGE_GENERATOR_PROVIDER=cloudflare  -> Cloudflare Workers AI REST API
# Auto-selected to "cloudflare" when CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN
# are set; otherwise "openai". flux-1-schnell is the fastest/cheapest model.
# IMAGE_GENERATOR_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token
# IMAGE_GENERATOR_CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Use scripts/cloudflare-image-test.ts (npm run cf:list / cf:image) to compare models.
#
# Cloudflare Workers AI can also back the responder (chat) directly via its
# OpenAI-compatible endpoint — no local proxy needed:
#   RESPONDER_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1
#   RESPONDER_API_KEY=<CLOUDFLARE_API_TOKEN>
#   RESPONDER_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Compare text models with npm run cf:chat (scripts/cloudflare-chat-test.ts).
#
# CF chat models cannot browse, so web search for profiles with tools.webSearch=true
# is done by the worker via Tavily (https://app.tavily.com, key starts with tvly-).
# Test the search->grounding loop with npm run tavily:test.
# TAVILY_API_KEY=your-tavily-key
# Sticker generation converts generated images to WhatsApp WebP stickers.
# MEDIA_FFMPEG_COMMAND can reuse CODEX_PROXY_FFMPEG_COMMAND or WHISPER_LOCAL_FFMPEG_COMMAND.
# MEDIA_FFMPEG_COMMAND=./data/whisper/ffmpeg/ffmpeg-8.1.1-essentials_build/bin/ffmpeg.exe
# MEDIA_STICKER_PYTHON=python
STICKER_SIZE=512
STICKER_QUALITY=65
STICKER_TIMEOUT_MS=60000

# Optional image understanding/OCR for inbound WhatsApp images. Profiles must
# opt in with tools.imageUnderstanding=true. With CLAUDE_PROXY_ENABLED=true the
# default provider is claude-cli (the `claude` CLI reads the image natively as a
# base64 block). With CODEX_PROXY_MEDIA_PROVIDER=codex-cli the default is
# codex-cli so Codex reads the local media path.
# IMAGE_UNDERSTANDING_PROVIDER=claude-cli
# IMAGE_UNDERSTANDING_PROVIDER=openai
# IMAGE_UNDERSTANDING_BASE_URL=https://api.openai.com/v1
# IMAGE_UNDERSTANDING_API_KEY=your-openai-api-key
# IMAGE_UNDERSTANDING_MODEL=gpt-4o-mini
IMAGE_UNDERSTANDING_TIMEOUT_MS=300000
IMAGE_UNDERSTANDING_MAX_IMAGE_BYTES=10485760
IMAGE_UNDERSTANDING_DETAIL=auto
# IMAGE_UNDERSTANDING_PROVIDER=codex-cli
# IMAGE_UNDERSTANDING_CODEX_SANDBOX=danger-full-access

# Optional text-to-speech for WhatsApp audio replies. Profiles must opt in with
# voice.reply.enabled=true and choose mode=on_request or always.
#
# SPEECH_PROVIDER=local renders directly with edge-tts (no proxy) — recommended
# for the Cloudflare backend (Cloudflare has no good pt-BR voice). Auto-selected
# when RESPONDER_PROVIDER=cloudflare. Needs Python + edge-tts + ffmpeg on the host.
# SPEECH_PROVIDER=local
# SPEECH_VOICE=pt-BR-FranciscaNeural
# SPEECH_RESPONSE_FORMAT=opus
# SPEECH_LOCAL_ENGINE=edge
# SPEECH_LOCAL_TTS_PYTHON=python3
# SPEECH_LOCAL_TTS_SCRIPT=./scripts/local-tts.py
#
# SPEECH_PROVIDER=openai uses an OpenAI-compatible /audio/speech endpoint.
# If CODEX_PROXY_ENABLED=true and CODEX_PROXY_MEDIA_PROVIDER is enabled, leaving
# SPEECH_BASE_URL unset sends speech generation through codex-proxy.
# SPEECH_BASE_URL=https://api.openai.com/v1
# SPEECH_API_KEY=your-openai-api-key
SPEECH_MODEL=gpt-4o-mini-tts
SPEECH_VOICE=alloy
SPEECH_RESPONSE_FORMAT=mp3
SPEECH_TIMEOUT_MS=60000

# Optional local Claude Code proxy for users who want to back replies with the
# `claude` CLI (Claude Code subscription) instead of a direct API key. Start it
# with `npm run claude-proxy`. Requires Claude Code installed and logged in
# (run `claude` once and `/login`). Image understanding (inbound image OCR/vision)
# then runs through the same `claude` CLI natively.
# CLAUDE_PROXY_ENABLED=true
# CLAUDE_PROXY_HOST=127.0.0.1
# Default 8789. Avoid 8787 (codex-proxy), 8788 (openclaw-control), 8790 (hook).
# CLAUDE_PROXY_PORT=8789
# CLAUDE_PROXY_API_KEY=dev-local-change-me
# Upstream Claude model: sonnet | opus | haiku, or a full claude-* id.
# CLAUDE_PROXY_MODEL=sonnet
# Optional reasoning effort for the claude CLI: low|medium|high|xhigh|max (blank = default).
# CLAUDE_PROXY_EFFORT=
# CLAUDE_PROXY_TIMEOUT_MS=180000
# CLAUDE_PROXY_MAX_PROMPT_CHARS=400000
# CLAUDE_PROXY_MAX_IMAGE_BYTES=5242880
# Override the claude executable if it is not on PATH (Windows default: claude.exe).
# CLAUDE_PROXY_CLAUDE_BIN=claude.exe
#
# Claude-proxy responder mode (set automatically from the defaults above when
# CLAUDE_PROXY_ENABLED=true; override only if you need to):
# RESPONDER_BASE_URL=http://127.0.0.1:8789/v1
# RESPONDER_API_KEY=dev-local-change-me
# RESPONDER_MODEL=sonnet
# RESPONDER_TIMEOUT_MS=120000

# Optional local Codex CLI proxy for users who want to back replies with
# `codex exec` instead of a direct API key.
# CODEX_PROXY_ENABLED=true
# CODEX_PROXY_HOST=127.0.0.1
# CODEX_PROXY_PORT=8787
# CODEX_PROXY_API_KEY=dev-local-change-me
# CODEX_PROXY_MODEL=gpt-5.4
# CODEX_PROXY_TIMEOUT_MS=120000
# CODEX_PROXY_MAX_PROMPT_CHARS=20000
# CODEX_PROXY_SANDBOX=read-only
# CODEX_PROXY_ALLOW_WEB_SEARCH=true
# CODEX_PROXY_WORKDIR=.

# Optional audio transcription behind codex-proxy. This is useful when you want
# local Whisper, or when you want a single local proxy endpoint for everything.
CODEX_PROXY_TRANSCRIBER_PROVIDER=off
# CODEX_PROXY_TRANSCRIBER_PROVIDER=openai
# CODEX_PROXY_TRANSCRIBER_API_KEY=your-transcriber-api-key
# CODEX_PROXY_TRANSCRIBER_MODEL=gpt-4o-mini-transcribe
# CODEX_PROXY_TRANSCRIBER_PROVIDER=local-whisper
# CODEX_PROXY_TRANSCRIBER_BASE_URL=http://127.0.0.1:2022/v1
# CODEX_PROXY_TRANSCRIBER_MODEL=base
# CODEX_PROXY_TRANSCRIBER_TIMEOUT_MS=60000

# Optional image and speech generation behind codex-proxy. OpenAI/custom modes
# are pass-through calls. codex-cli mode runs Codex CLI for images and local TTS
# for speech.
CODEX_PROXY_MEDIA_PROVIDER=off
# CODEX_PROXY_MEDIA_PROVIDER=openai
# CODEX_PROXY_MEDIA_API_KEY=your-openai-api-key
# CODEX_PROXY_MEDIA_BASE_URL=https://api.openai.com/v1
# CODEX_PROXY_MEDIA_PROVIDER=codex-cli
# CODEX_PROXY_MEDIA_CODEX_MODEL=gpt-5.5
# CODEX_PROXY_MEDIA_CODEX_SANDBOX=danger-full-access
# CODEX_PROXY_MEDIA_OUTPUT_DIR=./data/generated-media/codex-proxy
# CODEX_PROXY_FFMPEG_COMMAND=./data/whisper/ffmpeg/ffmpeg-8.1.1-essentials_build/bin/ffmpeg.exe
# IMAGE_GENERATOR_TIMEOUT_MS=300000
# SPEECH_RESPONSE_FORMAT=opus
# CODEX_PROXY_MEDIA_TIMEOUT_MS=300000
# Optional codex-cli local speech backends:
# CODEX_PROXY_LOCAL_SPEECH_ENGINE=system
# CODEX_PROXY_LOCAL_SPEECH_ENGINE=edge
# CODEX_PROXY_LOCAL_SPEECH_ENGINE=piper
# CODEX_PROXY_LOCAL_SPEECH_VOICE=pt-BR-FranciscaNeural
# CODEX_PROXY_LOCAL_TTS_SCRIPT=./scripts/local-tts.py
# CODEX_PROXY_LOCAL_TTS_PYTHON=python
# CODEX_PROXY_LOCAL_TTS_RATE=+0%
# CODEX_PROXY_LOCAL_TTS_PITCH=+0Hz
# CODEX_PROXY_LOCAL_TTS_VOLUME=+0%
# CODEX_PROXY_LOCAL_TTS_LENGTH_SCALE=1.0
# CODEX_PROXY_LOCAL_TTS_VOICES_DIR=./voices

# Codex-proxy responder mode.
# RESPONDER_BASE_URL=http://127.0.0.1:8787/v1
# RESPONDER_API_KEY=dev-local-change-me
# RESPONDER_MODEL=gpt-5.4
# RESPONDER_TIMEOUT_MS=120000

# Voice transcription. Profiles must explicitly enable voice before the worker
# transcribes audio messages. Direct API mode reuses RESPONDER_API_KEY unless
# TRANSCRIBER_API_KEY is set separately.
#
# TRANSCRIBER_PROVIDER=cloudflare uses Cloudflare Workers AI Whisper
# (whisper-large-v3-turbo) — recommended for the Cloudflare backend; derives
# URL/key from CLOUDFLARE_ACCOUNT_ID/TOKEN, no local Whisper server needed.
# TRANSCRIBER_PROVIDER=cloudflare
# TRANSCRIBER_CLOUDFLARE_MODEL=@cf/openai/whisper-large-v3-turbo
TRANSCRIBER_BASE_URL=https://api.openai.com/v1
# TRANSCRIBER_API_KEY=your-transcriber-api-key
TRANSCRIBER_MODEL=gpt-4o-mini-transcribe
TRANSCRIBER_TIMEOUT_MS=60000
# TRANSCRIBER_PROMPT=Mensagem de WhatsApp em portugues brasileiro.

# Optional local Whisper server managed by npm run warmup:whisper.
# Local Whisper also requires CODEX_PROXY_ENABLED=true because the worker sends
# transcription requests through codex-proxy in this mode.
WHISPER_LOCAL_MODEL=base
WHISPER_LOCAL_HOST=127.0.0.1
WHISPER_LOCAL_PORT=2022
# Set true if you want npm run warmup to also start the local Whisper server.
WHISPER_LOCAL_ENABLED=false
# WHISPER_LOCAL_THREADS=4
# WHISPER_LOCAL_COMMAND=C:\path\to\whisper-server.exe
# WHISPER_LOCAL_FFMPEG_COMMAND=C:\path\to\ffmpeg.exe

# Twilio direct-send smoke test. Do not commit real credentials.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_CHANNEL=whatsapp
# TWILIO_FROM=whatsapp:+14155238886
# TWILIO_TO=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio inbound webhook. Configure this in Twilio as:
#   https://<your-public-tunnel>/twilio/whatsapp
TWILIO_WORKER_PORT=8791
TWILIO_WEBHOOK_PATH=/twilio/whatsapp
TWILIO_VALIDATE_SIGNATURE=true
# TWILIO_WEBHOOK_URL=https://example.ngrok-free.app/twilio/whatsapp
